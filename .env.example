# Copy to .env.local for local development.
#
# Both values are PUBLIC — they ship inside the JavaScript bundle that anyone
# can read. That is how Supabase is designed to work from a browser: all real
# security is enforced by row-level security policies in Postgres.
#
# Find them at: Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
